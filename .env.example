# NAMES/PLACEHOLDERS ONLY — never commit or paste real secrets into chat.
# Browser: only publishable configuration, point staging dashboard to STAGING project.
SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Edge runtime normally supplies SUPABASE_URL and a modern key map (or legacy key).
# SUPABASE_PUBLISHABLE_KEYS / SUPABASE_ANON_KEY
# SUPABASE_SECRET_KEYS / SUPABASE_SERVICE_ROLE_KEY — backend only

# Edge secrets, set through Supabase secret management in the selected staging project.
PULSO_HANDOFF_HMAC_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PULSO_RATE_HASH_KEY=REPLACE_WITH_AN_INDEPENDENT_RANDOM_SECRET
PULSO_META_CREDENTIAL_KEY_V1=REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES
PULSO_META_WORKER_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# An explicit supported Graph API version, reviewed against current official Meta docs.
META_GRAPH_VERSION=REPLACE_WITH_REVIEWED_VERSION
# Exact HTTPS origins, comma separated, no trailing slash or wildcard.
PULSO_ADMIN_ORIGINS=https://YOUR_STAGING_DASHBOARD.example
PULSO_DASHBOARD_ORIGINS=https://YOUR_STAGING_DASHBOARD.example
# Optional: unset means IP is NOT collected. Only after verifying ingress removes
# caller-supplied header and supplies its own single IP. Never X-Forwarded-For.
PULSO_TRUSTED_IP_HEADER=

# Test database only: explicit loopback opt-in, never Supabase production credentials.
PULSO_TEST_DATABASE_URL=postgres://postgres@127.0.0.1:55432/postgres
# Hottok and Meta CAPI access token are entered in the authorized app, scoped per
# workspace; do not create global HOTMART_HOTTOK/META_CAPI_ACCESS_TOKEN browser vars.

# Staging also supports service-only Supabase Vault runtime config; see docs/VAULT_RUNTIME.md.
# Configure either a complete component environment or Vault, never a partial mixture.
# Meta Ads reads use the same backend origins/AES key/Graph version as meta_connect,
# with separate encrypted credentials. Account ID + ads_read token are entered only
# in the protected workspace form, never in browser environment variables.
