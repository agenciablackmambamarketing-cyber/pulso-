# Never commit real values here.
# Frontend uses only Supabase publishable key; no private tokens may be sent to browsers.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Secrets belong only in Supabase Edge Function secrets or another backend secret manager:
# SUPABASE_SECRET_KEYS (backend only)
# META_CAPI_ACCESS_TOKEN (backend only, one credential per authorized workspace)
# HOTMART_HOTTOK (must never be put in frontend or repo)